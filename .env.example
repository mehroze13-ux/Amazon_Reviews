# HuggingFace API token (free) ─────────────────────────────────────────────────
# Get one at: https://huggingface.co/settings/tokens
# Without this, tagging falls back to VADER (works offline, no download needed)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard port ────────────────────────────────────────────────────────────────
PORT=8000
